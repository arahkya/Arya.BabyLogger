<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Arya.BabyLogger.Mobile.MainPage">

    <Grid ColumnSpacing="10"
          RowSpacing="10"
          Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="100*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="50*"/>
        </Grid.ColumnDefinitions>

        <Button
            Grid.Row="0"
            Grid.Column="0"
            Text="ป้อนนม"/>

        <Button
            Grid.Row="0"
            Grid.Column="1"
            Text="เปลี่ยนผ้าอ้อม"/>

        <Button
            Grid.Row="1"
            Grid.Column="0"
            Text="นอน"/>

        <Button
            Grid.Row="1"
            Grid.Column="1"
            Text="อื่นๆ"/>

        <Label
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            VerticalOptions="End"
            Text="Select Date"/>

        <DatePicker
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalOptions="FillAndExpand"/>

        <CollectionView
            Grid.Row="4"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            VerticalOptions="FillAndExpand"
            ItemsSource="{Binding BabyEvents}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame
                        Padding="10"
                        Margin="5"
                        BorderColor="LightGray"
                        CornerRadius="5">
                        <StackLayout>
                            <Label
                                Text="{Binding EventType}"
                                FontAttributes="Bold"/>
                            <Label
                                Text="{Binding EventTime, StringFormat='{}{0:dd MMM yyyy HH:mm}'}"/>
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>

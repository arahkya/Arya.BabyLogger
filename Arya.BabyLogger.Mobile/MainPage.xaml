<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Arya.BabyLogger.Mobile.MainPage"
             BackgroundColor="#F5F7FB">

    <ContentPage.Resources>
        <FontImageSource x:Key="FeedIcon"
                         Glyph="🍼"
                         Color="#FF8C42"
                         Size="32"/>
        <FontImageSource x:Key="DiaperIcon"
                         Glyph="🧷"
                         Color="#4BB3FD"
                         Size="32"/>
        <FontImageSource x:Key="SleepIcon"
                         Glyph="💤"
                         Color="#7A6FF0"
                         Size="32"/>
        <FontImageSource x:Key="OtherIcon"
                         Glyph="✨"
                         Color="#00B89B"
                         Size="32"/>

        <Shadow x:Key="MenuButtonShadow"
                Radius="12"
                Opacity="0.2"
                Brush="#33000000"
                Offset="0,6"/>

        <Shadow x:Key="CardShadow"
                Radius="10"
                Opacity="0.12"
                Brush="#19000000"
                Offset="0,4"/>

        <Style x:Key="MenuButtonStyle"
               TargetType="Button">
            <Setter Property="TextColor"
                    Value="#1E1E2A"/>
            <Setter Property="FontAttributes"
                    Value="Bold"/>
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="CornerRadius"
                    Value="16"/>
            <Setter Property="Padding"
                    Value="16,14"/>
            <Setter Property="ContentLayout"
                    Value="Top,10"/>
            <Setter Property="Shadow"
                    Value="{StaticResource MenuButtonShadow}"/>
        </Style>
    </ContentPage.Resources>

    <Grid ColumnSpacing="10"
          RowSpacing="10"
          Padding="20"
          BackgroundColor="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="100*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="50*"/>
        </Grid.ColumnDefinitions>

        <Button
            Grid.Row="0"
            Grid.Column="0"
            Style="{StaticResource MenuButtonStyle}"
            Text="ป้อนนม"
            ImageSource="{StaticResource FeedIcon}"
            BackgroundColor="#FFF1E5"
            Clicked="OnFeedingButtonClicked"/>

        <Button
            Grid.Row="0"
            Grid.Column="1"
            Style="{StaticResource MenuButtonStyle}"
            Text="เปลี่ยนผ้าอ้อม"
            ImageSource="{StaticResource DiaperIcon}"
            BackgroundColor="#E6F4FF"/>

        <Button
            Grid.Row="1"
            Grid.Column="0"
            Style="{StaticResource MenuButtonStyle}"
            Text="นอน"
            ImageSource="{StaticResource SleepIcon}"
            BackgroundColor="#EEE9FF"/>

        <Button
            Grid.Row="1"
            Grid.Column="1"
            Style="{StaticResource MenuButtonStyle}"
            Text="อื่นๆ"
            ImageSource="{StaticResource OtherIcon}"
            BackgroundColor="#E6FFF7"/>

        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Margin="0,4,0,0"
                Padding="12 5 12 12"
                BackgroundColor="#FFFFFF"
                Stroke="#E2E8F0"
                VerticalOptions="Center">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="35"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0"
                       Text="วันที่"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       TextColor="#0F172A"/>
                <DatePicker Grid.Column="1"
                            HorizontalOptions="FillAndExpand"
                            BackgroundColor="#F8FAFC"
                            TextColor="#0F172A"
                            Margin="0,0,0,0"/>
                <ImageButton Grid.Column="2"
                             WidthRequest="15"
                             HeightRequest="15"
                             Padding="6"
                             BackgroundColor="Transparent"
                             Source="ellipsis_vertical.png"
                             HorizontalOptions="End"
                             VerticalOptions="Center"
                             CornerRadius="8">
                </ImageButton>
            </Grid>
        </Border>

        <CollectionView
            Grid.Row="4"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            VerticalOptions="FillAndExpand"
            BackgroundColor="White "
            ItemsSource="{Binding BabyEvents}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Padding="12"
                        Margin="8,6"
                        Shadow="{StaticResource CardShadow}"
                        BackgroundColor="#FFFFFF">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    Padding="0"
                                    Stroke="#E2E8F0"
                                    BackgroundColor="#EEF2FF">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Image WidthRequest="26"
                                       HeightRequest="26"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Source="{StaticResource OtherIcon}">
                                    <Image.Triggers>
                                        <DataTrigger TargetType="Image"
                                                     Binding="{Binding EventType}"
                                                     Value="ป้อนนม">
                                            <Setter Property="Source"
                                                    Value="{StaticResource FeedIcon}"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Image"
                                                     Binding="{Binding EventType}"
                                                     Value="ขวดนม">
                                            <Setter Property="Source"
                                                    Value="{StaticResource FeedIcon}"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Image"
                                                     Binding="{Binding EventType}"
                                                     Value="ป้อนนมระหว่างหลับ">
                                            <Setter Property="Source"
                                                    Value="{StaticResource FeedIcon}"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Image"
                                                     Binding="{Binding EventType}"
                                                     Value="ป้อนนมเที่ยงคืน">
                                            <Setter Property="Source"
                                                    Value="{StaticResource FeedIcon}"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Image"
                                                     Binding="{Binding EventType}"
                                                     Value="ป้อนนมเช้ามืด">
                                            <Setter Property="Source"
                                                    Value="{StaticResource FeedIcon}"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Image"
                                                     Binding="{Binding EventType}"
                                                     Value="ชิมอาหารบด">
                                            <Setter Property="Source"
                                                    Value="{StaticResource FeedIcon}"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Image"
                                                     Binding="{Binding EventType}"
                                                     Value="เปลี่ยนผ้าอ้อม">
                                            <Setter Property="Source"
                                                    Value="{StaticResource DiaperIcon}"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Image"
                                                     Binding="{Binding EventType}"
                                                     Value="นอน">
                                            <Setter Property="Source"
                                                    Value="{StaticResource SleepIcon}"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Image"
                                                     Binding="{Binding EventType}"
                                                     Value="งีบ">
                                            <Setter Property="Source"
                                                    Value="{StaticResource SleepIcon}"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Image"
                                                     Binding="{Binding EventType}"
                                                     Value="งีบในรถเข็น">
                                            <Setter Property="Source"
                                                    Value="{StaticResource SleepIcon}"/>
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4">
                                <Label
                                    Text="{Binding EventType}"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    TextColor="#0F172A"/>
                                <Label
                                    Text="{Binding EventTime, StringFormat='{}{0:dd MMM yyyy HH:mm}'}"
                                    FontSize="13"
                                    TextColor="#64748B"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>

<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Arya.BabyLogger.Mobile.Views.Landing.GreetingPage"
             xmlns:landingViewModels="clr-namespace:Arya.BabyLogger.Mobile.ViewModels.Landing"
             x:DataType="landingViewModels:GreetingViewModel"
             Title="Welcome">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PageBg">#F6F4F1</Color>
            <Color x:Key="CardBg">#FFFFFF</Color>
            <Color x:Key="CardStroke">#E6E1DA</Color>
            <Color x:Key="AccentText">#2D2A26</Color>
            <Color x:Key="MutedText">#6E655B</Color>
            <Color x:Key="Accent">#E4942A</Color>
            <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFA651" Offset="0"/>
                <GradientStop Color="#FFB97A" Offset="1"/>
            </LinearGradientBrush>

            <Style x:Key="EntryStyle"
                   TargetType="Entry">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="TextColor" Value="{StaticResource AccentText}"/>
                <Setter Property="PlaceholderColor" Value="{StaticResource MutedText}"/>
            </Style>

            <Style x:Key="PrimaryButton"
                   TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Accent}"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="HeightRequest" Value="52"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView BackgroundColor="{StaticResource PageBg}">
        <Grid Padding="22,28,22,18"
              RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border StrokeThickness="0"
                    Padding="18"
                    Background="{StaticResource HeroGradient}"
                    StrokeShape="RoundRectangle 22">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border 
                            StrokeThickness="0"
                            Padding="0,6"
                            StrokeShape="RoundRectangle 12"
                            HorizontalOptions="Start">
                        <Label Text="BabyLogger"
                               TextColor="Black"
                               FontAttributes="Bold"
                               FontSize="30"/>
                    </Border>

                    <Label Grid.Column="0" Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Text="สวัสดีคุณแม่ ยินดีต้อนรับกลับมา!"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="Black"
                           Margin="0,8,0,4"/>
                    <Label Grid.Row="2"
                           Grid.Column="0"
                           Text="บันทึกรอบปั๊มนม การให้นม และช่วงเวลากอดได้อย่างไม่พลาดจังหวะ"
                           FontSize="14"
                           TextColor="#FDF6EE"/>

                    <Border Grid.Row="0" Grid.Column="1"
                            Grid.RowSpan="3"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            Padding="6"
                            VerticalOptions="Center">
                        <Image Source="mother_breast_pumping.png"
                               Aspect="AspectFit"
                               HeightRequest="120"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Stroke="{StaticResource CardStroke}"
                    BackgroundColor="{StaticResource CardBg}"
                    StrokeThickness="1"
                    Padding="16"
                    StrokeShape="RoundRectangle 18">
                <Border.Shadow>
                    <Shadow Brush="#22000000"
                            Offset="0,6"
                            Radius="18"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource MutedText}"/>
                        <Entry x:Name="EmailEntry"
                               Style="{StaticResource EntryStyle}"
                               Placeholder="you@example.com"
                               Text="{Binding Email}"
                               Keyboard="Email"/>
                        <Label Text="{Binding EmailError}"
                               FontSize="12"
                               TextColor="Red"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Password"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource MutedText}"/>
                        <Entry x:Name="PasswordEntry"
                               Style="{StaticResource EntryStyle}"
                               Text="{Binding Password}"
                               Placeholder="********"
                               IsPassword="True"/>
                        <Label Text="{Binding PasswordError}"
                               FontSize="12"
                               TextColor="Red"/>
                    </VerticalStackLayout>

                    <Button Text="เข้าสู่ระบบ"
                            Style="{StaticResource PrimaryButton}" 
                            Command="{Binding LoginCommand}"/>

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="Red"
                           HorizontalTextAlignment="Center"></Label>
                    
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <BoxView HeightRequest="1" WidthRequest="50" Color="{StaticResource CardStroke}" VerticalOptions="Center"/>
                        <Label Text="หรือ"
                               FontSize="12"
                               TextColor="{StaticResource MutedText}"/>
                        <BoxView HeightRequest="1" WidthRequest="50" Color="{StaticResource CardStroke}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <Button Text="สร้างบัญชี"
                            BackgroundColor="#FFFFFF"
                            TextColor="{StaticResource AccentText}"
                            BorderColor="{StaticResource CardStroke}"
                            Command="{Binding GotoRegisterPageCommand}"
                            BorderWidth="1"
                            CornerRadius="14"
                            HeightRequest="48"/>
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout Grid.Row="2"
                                   Spacing="6"
                                   HorizontalOptions="Center">
                <Label Text="ลืมรหัสผ่าน?"
                       FontSize="13"
                       TextColor="{StaticResource MutedText}"/>
                <Label Text="แตะที่นี่"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Accent}"
                       >
                    <!-- <Label.GestureRecognizers> -->
                    <!--     <TapGestureRecognizer Tapped="TapGestureRecognizer_OnTapped" /> -->
                    <!-- </Label.GestureRecognizers> -->
                </Label>
            </HorizontalStackLayout>

            <StackLayout Grid.Row="3"
                         Orientation="Horizontal"
                         Spacing="10"
                         HorizontalOptions="Center">
                <BoxView WidthRequest="8"
                         HeightRequest="8"
                         Color="{StaticResource Accent}"
                         CornerRadius="4"/>
                <Label Text="ก้าวเล็กๆ ในแต่ละวันกับ BabyLogger"
                       FontSize="12"
                       TextColor="{StaticResource MutedText}"
                       HorizontalTextAlignment="Center"/>
            </StackLayout>
        </Grid>
    </ScrollView>
</ContentPage>

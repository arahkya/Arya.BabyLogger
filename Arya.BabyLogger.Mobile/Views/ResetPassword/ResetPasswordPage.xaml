<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModel="clr-namespace:Arya.BabyLogger.Mobile.ViewModels.ResetPassword"
             x:DataType="viewModel:ResetPasswordViewModel"
             x:Class="Arya.BabyLogger.Mobile.Views.ResetPassword.ResetPasswordPage"
             Title="Reset Password">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PageBg">#F6F4F1</Color>
            <Color x:Key="CardBg">#FFFFFF</Color>
            <Color x:Key="CardStroke">#E6E1DA</Color>
            <Color x:Key="AccentText">#2D2A26</Color>
            <Color x:Key="MutedText">#6E655B</Color>
            <Color x:Key="Accent">#E4942A</Color>
            <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFA651" Offset="0"/>
                <GradientStop Color="#FFB97A" Offset="1"/>
            </LinearGradientBrush>

            <Style x:Key="EntryStyle"
                   TargetType="Entry">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="TextColor" Value="{StaticResource AccentText}"/>
                <Setter Property="PlaceholderColor" Value="{StaticResource MutedText}"/>
                <Setter Property="HeightRequest" Value="46"/>
            </Style>

            <Style x:Key="PrimaryButton"
                   TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Accent}"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="HeightRequest" Value="52"/>
            </Style>
            
            <Style x:Key="SecondaryButton"
                   TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource White}"/>
                <Setter Property="BorderColor" Value="lightgray"/>
                <Setter Property="BorderWidth" Value="1"></Setter>
                <Setter Property="TextColor" Value="Black"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="HeightRequest" Value="52"/>
            </Style>

            <Style x:Key="InactiveButton" BasedOn="{StaticResource PrimaryButton}"
                   TargetType="Button">
                <Setter Property="BackgroundColor" Value="LightGray"/>
                <Setter Property="TextColor" Value="Black"/>
            </Style>
            
            <Style x:Key="ValidationLabel"
                   TargetType="Label">
                <Setter Property="TextColor" Value="#D32F2F"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="IsVisible" Value="False"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView BackgroundColor="{StaticResource PageBg}">
        <Grid Padding="22,28,22,18"
              RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border StrokeThickness="0"
                    Padding="18"
                    Background="{StaticResource HeroGradient}"
                    StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="6">
                    <Label Text="กรอกรหัสที่ได้รับ"
                           TextColor="Black"
                           FontSize="22"
                           FontAttributes="Bold"/>
                    <Label Text="ใส่โค้ด 6 หลัก และตั้งรหัสผ่านใหม่ที่จดจำง่าย"
                           TextColor="#FDF6EE"
                           FontSize="14"/>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="1"
                    Stroke="{StaticResource CardStroke}"
                    BackgroundColor="{StaticResource CardBg}"
                    StrokeThickness="1"
                    Padding="18"
                    StrokeShape="RoundRectangle 18">
                <Border.Shadow>
                    <Shadow Brush="#22000000"
                            Offset="0,6"
                            Radius="18"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="รหัสยืนยัน"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource MutedText}"/>
                        <Entry Style="{StaticResource EntryStyle}"
                               Keyboard="Numeric"
                               Placeholder="000000"
                               Text="{Binding SecretCode}"/>
                        <Label Text="โค้ดต้องเป็นตัวเลข 6 หลัก"
                               Style="{StaticResource ValidationLabel}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding ShowCodeError}"
                                             Value="True">
                                    <Setter Property="IsVisible" Value="True"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="รหัสผ่านใหม่"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource MutedText}"/>
                        <Entry Style="{StaticResource EntryStyle}"
                               IsPassword="True"
                               Placeholder="********"
                               Text="{Binding NewPassword}"/>
                        <Label Text="รหัสผ่านต้องมีอย่างน้อย 8 ตัวอักษร"
                               Style="{StaticResource ValidationLabel}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding ShowPasswordError}"
                                             Value="True">
                                    <Setter Property="IsVisible" Value="True"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="ยืนยันรหัสผ่าน"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource MutedText}"/>
                        <Entry Style="{StaticResource EntryStyle}"
                               IsPassword="True"
                               Placeholder="********"
                               Text="{Binding ConfirmPassword}"/>
                        <Label Text="รหัสผ่านไม่ตรงกัน"
                               Style="{StaticResource ValidationLabel}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding ShowConfirmError}"
                                             Value="True">
                                    <Setter Property="IsVisible" Value="True"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>

                    <Button Text="ตั้งรหัสผ่านใหม่"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ResetPasswordCommand}"
                            IsEnabled="{Binding CanSubmit}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding CanSubmit}"
                                         Value="true">
                                <Setter Property="Style" Value="{StaticResource PrimaryButton}"></Setter>
                            </DataTrigger>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding CanSubmit}"
                                         Value="false">
                                <Setter Property="Style" Value="{StaticResource InactiveButton}"></Setter>
                            </DataTrigger>
                        </Button.Triggers>
                        
                    </Button>

                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                        <BoxView HeightRequest="1" WidthRequest="50" Color="{StaticResource CardStroke}" VerticalOptions="Center"/>
                        <Label Text="หรือ"
                               FontSize="12"
                               TextColor="{StaticResource MutedText}"/>
                        <BoxView HeightRequest="1" WidthRequest="50" Color="{StaticResource CardStroke}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    
                    <Button Text="ปิด เพื่อกลับไปส่งอีเมล์อีกครั้ง"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding CloseCommand}"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>

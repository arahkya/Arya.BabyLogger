<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModel="clr-namespace:Arya.BabyLogger.Mobile.ViewModels.ResetPassword"
             x:DataType="viewModel:RequestResetPasswordViewModel"
             x:Class="Arya.BabyLogger.Mobile.Views.ResetPassword.RequestResetPasswordPage"
             Title="Reset Password">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PageBg">#F6F4F1</Color>
            <Color x:Key="CardBg">#FFFFFF</Color>
            <Color x:Key="CardStroke">#E6E1DA</Color>
            <Color x:Key="AccentText">#2D2A26</Color>
            <Color x:Key="MutedText">#6E655B</Color>
            <Color x:Key="Accent">#E4942A</Color>
            <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFA651" Offset="0"/>
                <GradientStop Color="#FFB97A" Offset="1"/>
            </LinearGradientBrush>

            <Style x:Key="EntryStyle"
                   TargetType="Entry">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="TextColor" Value="{StaticResource AccentText}"/>
                <Setter Property="PlaceholderColor" Value="{StaticResource MutedText}"/>
                <Setter Property="HeightRequest" Value="46"/>
            </Style>

            <Style x:Key="PrimaryButton"
                   TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Accent}"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="HeightRequest" Value="52"/>
            </Style>
            
            <Style x:Key="InactiveButton" BasedOn="{StaticResource PrimaryButton}"
                   TargetType="Button">
                <Setter Property="BackgroundColor" Value="LightGray"/>
                <Setter Property="TextColor" Value="Black"/>
            </Style>

            <Style x:Key="ValidationLabel"
                   TargetType="Label">
                <Setter Property="TextColor" Value="#D32F2F"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="IsVisible" Value="False"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView BackgroundColor="{StaticResource PageBg}">
        <Grid Padding="22,28,22,18"
              RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border StrokeThickness="0"
                    Padding="18"
                    Background="{StaticResource HeroGradient}"
                    StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="6">
                    <Label Text="ลืมรหัสผ่าน?"
                           TextColor="Black"
                           FontSize="24"
                           FontAttributes="Bold"/>
                    <Label Text="กรอกอีเมลที่ใช้สมัคร เราจะส่งรหัสยืนยันให้ทันที"
                           TextColor="#FDF6EE"
                           FontSize="14"/>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="1"
                    Stroke="{StaticResource CardStroke}"
                    BackgroundColor="{StaticResource CardBg}"
                    StrokeThickness="1"
                    Padding="18"
                    StrokeShape="RoundRectangle 18">
                <Border.Shadow>
                    <Shadow Brush="#22000000"
                            Offset="0,6"
                            Radius="18"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource MutedText}"/>
                        <Entry x:Name="EmailEntry"
                               Style="{StaticResource EntryStyle}"
                               Placeholder="you@example.com"
                               Keyboard="Email"
                               Text="{Binding Email}" />
                        <Label Style="{StaticResource ValidationLabel}"
                               Text="รูปแบบอีเมล์ไม่ถูกต้อง"
                               HorizontalTextAlignment="Center"
                               IsVisible="{Binding ShowEmailError}" />
                    </VerticalStackLayout>

                    <Button Text="ส่งรหัสยืนยัน"
                            Style="{StaticResource InactiveButton}"
                            Command="{Binding RequestSecretCodeCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding IsEmailValid}"
                                         Value="true">
                                <Setter Property="Style" Value="{StaticResource PrimaryButton}"></Setter>
                            </DataTrigger>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding IsEmailValid}"
                                         Value="false">
                                <Setter Property="Style" Value="{StaticResource InactiveButton}"></Setter>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Label Text="คุณจะได้รับรหัสในอีเมล์ โปรดตรวจสอบ Inbox และ Junk Box"
                           FontSize="12"
                           TextColor="{StaticResource MutedText}"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>

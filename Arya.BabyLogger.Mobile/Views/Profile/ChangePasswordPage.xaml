<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Arya.BabyLogger.Mobile.Views.Profile.ChangePasswordPage"
             Title="Change Password">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="Change Password"
                   FontSize="28"
                   FontAttributes="Bold" />

            <VerticalStackLayout Spacing="6">
                <Label Text="Current Password" FontAttributes="Bold" />
                <Entry x:Name="CurrentPasswordEntry"
                       IsPassword="True"
                       Placeholder="Enter current password"
                       Text="{Binding CurrentPassword, Mode=TwoWay}" />
                <Label Text="{Binding CurrentPasswordError}"
                       TextColor="Red"
                       FontSize="12">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding CurrentPasswordError}" Value="">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding CurrentPasswordError}" Value="{x:Null}">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding CurrentPasswordError}" Value="{x:Static x:String.Empty}">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>
            
            <VerticalStackLayout Spacing="6">
                <Label Text="New Password" FontAttributes="Bold" />
                <Entry x:Name="NewPasswordEntry"
                       IsPassword="True"
                       Placeholder="Enter new password"
                       Text="{Binding NewPassword, Mode=TwoWay}" />
                <Label Text="{Binding NewPasswordError}"
                       TextColor="Red"
                       FontSize="12">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding NewPasswordError}" Value="">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding NewPasswordError}" Value="{x:Null}">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding NewPasswordError}" Value="{x:Static x:String.Empty}">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Confirm Password" FontAttributes="Bold" />
                <Entry x:Name="ConfirmPasswordEntry"
                       IsPassword="True"
                       Placeholder="Re-enter new password"
                       Text="{Binding ConfirmPassword, Mode=TwoWay}" />
                <Label Text="{Binding ConfirmPasswordError}"
                       TextColor="Red"
                       FontSize="12">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding ConfirmPasswordError}" Value="">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding ConfirmPasswordError}" Value="{x:Null}">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding ConfirmPasswordError}" Value="{x:Static x:String.Empty}">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>

            <Button Text="Update"
                    Command="{Binding UpdateCommand}"
                    BackgroundColor="#FFCE99"
                    TextColor="Black"
                    CornerRadius="8"
                    HeightRequest="48">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#FFCE99" />
                                    <Setter Property="TextColor" Value="Black" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#E0E0E0" />
                                    <Setter Property="TextColor" Value="#7A7A7A" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

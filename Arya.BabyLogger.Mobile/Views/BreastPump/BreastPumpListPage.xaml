<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Arya.BabyLogger.Mobile.Views.BreastPump.BreastPumpListPage"
             x:DataType="viewModels:BreastPumpListViewModel"
             xmlns:viewModels="clr-namespace:Arya.BabyLogger.Mobile.ViewModels.BreastPump"
             Title="ปั๊มนม">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="เพิ่ม"
                     Command="{Binding AddNewBreastPumpCommand}"/>
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding BreastPumpItemsGroup}"
                    IsGrouped="True">
        <CollectionView.GroupHeaderTemplate>
            <DataTemplate x:DataType="viewModels:BreastPumpGroupViewModel">
                <Grid BackgroundColor="LightGray"
                      Padding="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Text="{Binding GroupTitle}"
                           FontAttributes="Bold"/>
                    <Label Text="{Binding TotalAmountInMl, StringFormat='Total: {0} ml'}"
                           Grid.Column="1"
                           FontAttributes="Bold"/>
                </Grid>
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="viewModels:BreastPumpItemViewModel">
                <Border Margin="5"
                        Padding="10"
                        Stroke="LightGray">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding ItemSelectedCommand}"
                            CommandParameter="{Binding .}"/>
                    </Border.GestureRecognizers>

                    <Grid
                        HorizontalOptions="FillAndExpand">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Text="{Binding PumpTimeString}"/>
                        <Label Text="{Binding AmountInMl, StringFormat='{0} ml'}"
                               FontAttributes="Bold"
                               Grid.Column="1"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
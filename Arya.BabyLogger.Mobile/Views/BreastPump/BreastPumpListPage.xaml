<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Arya.BabyLogger.Mobile.Views.BreastPump.BreastPumpListPage"
             x:DataType="viewModels:BreastPumpListViewModel"
             xmlns:viewModels="clr-namespace:Arya.BabyLogger.Mobile.ViewModels.BreastPump"
             Title="{StaticResource AppName}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="ตั้งค่า"
                     Order="Secondary"
                     Command="{Binding SettingCommand}"/>        
    </ContentPage.ToolbarItems>
    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PageBg">#FFCE99</Color>
            <Color x:Key="PageHeroBg">#FF9644</Color>
            <Color x:Key="PageHeroPrimaryText">Black</Color>
            <Color x:Key="PageHeroSecondaryText">White</Color>
            <Color x:Key="ListBg">#FFFDF1</Color>
            <Color x:Key="ListIconBg">#F3EDE6</Color>
            <Color x:Key="ListIconStroke">#E5DDD2</Color>
            <Color x:Key="CardBg">#FFFFFF</Color>
            <Color x:Key="CardStroke">#E6E1DA</Color>
            <Color x:Key="AccentText">#2D2A26</Color>
            <Color x:Key="MutedText">#6E655B</Color>
            <Color x:Key="NewButtonBg">#562F00</Color>
            <Color x:Key="NewButtonTextColor">White</Color>

            <Style x:Key="CardBorder"
                   TargetType="Border">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource CardBg}"/>
                <Setter Property="Stroke"
                        Value="{StaticResource CardStroke}"/>
                <Setter Property="StrokeThickness"
                        Value="1"/>
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="16"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Padding"
                        Value="14"/>
                <Setter Property="Margin"
                        Value="15,6"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="{StaticResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource PageHeroBg}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>
                    <Label Text="ถึงเวลาปั้มนมในอีก"
                           FontSize="14"
                           TextColor="{StaticResource PageHeroSecondaryText}"
                           Padding="12,12,12,0"
                           Grid.ColumnSpan="2"
                           HorizontalOptions="Center"/>
                    <Label Grid.Column="0" Text="{Binding RemainingMinutesTilNextPump}"
                           Grid.Row="1"
                           Grid.ColumnSpan="2"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PageHeroPrimaryText}"
                           Padding="12,0,12,0"
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding NextPumpTime}"
                           Grid.Row="2"
                           Grid.Column="0"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PageHeroSecondaryText}"
                           Padding="12,0,12,9"
                           Margin="0,0,0,0"
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding TimeIntervalInHours, StringFormat='(รอบละ {0} ชั่วโมง)'}"
                           Grid.Row="2"
                           Grid.Column="1"
                           FontSize="14"
                           TextColor="{StaticResource PageHeroSecondaryText}"
                           Padding="0,0,12,9"
                           HorizontalTextAlignment="End"
                           HorizontalOptions="End"/>
                </Grid>
            </Border>
        </Grid>
        <RefreshView Grid.Row="1"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsLoading}">
            <CollectionView
                        ItemsSource="{Binding BreastPumpItemsGroup}"
                        BackgroundColor="{StaticResource ListBg}"
                        IsGrouped="True"
                        SelectionMode="None">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="viewModels:BreastPumpGroupViewModel">
                    <Grid
                        Padding="12"
                        Margin="10,0"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Text="{Binding GroupTitle}"
                               FontAttributes="Bold"
                               FontSize="14"
                               Grid.Row="0"
                               TextColor="{StaticResource AccentText}"/>
                        <Label Grid.Column="0" Text="สรุปประจำวัน"
                               FontSize="12"
                               Grid.Row="1"
                               TextColor="{StaticResource MutedText}"/>

                        <Label Grid.Column="0" Text="{Binding TotalAmountInMl, StringFormat='{0} ml'}"
                               Grid.Row="0"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="{StaticResource AccentText}"
                               HorizontalTextAlignment="End"/>
                        <Label Grid.Column="0" Text="รวมทั้งหมด"
                               Grid.Row="1"
                               FontSize="11"
                               TextColor="{StaticResource MutedText}"
                               HorizontalTextAlignment="End"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:BreastPumpItemViewModel">
                    <Border Style="{StaticResource CardBorder}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding ItemSelectedCommand}"
                                CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="12"
                              VerticalOptions="Center">
                            <Border BackgroundColor="{StaticResource ListIconBg}"
                                    Stroke="{StaticResource ListIconStroke}"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="8"
                                    WidthRequest="40"
                                    HeightRequest="40">
                                <Image Source="{StaticResource BreastPumpIcon}"
                                       WidthRequest="35"
                                       HeightRequest="35"/>
                            </Border>
                            <StackLayout Grid.Column="1"
                                         Spacing="2">
                                <Label Text="{Binding PumpTimeString}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource AccentText}"/>
                                <Label Text="เวลาบันทึก"
                                       FontSize="12"
                                       TextColor="{StaticResource MutedText}"/>
                            </StackLayout>
                            <StackLayout Grid.Column="2"
                                         HorizontalOptions="End"
                                         Spacing="2">
                                <Label Text="{Binding AmountInMl, StringFormat='{0} ml'}"
                                       FontAttributes="Bold"
                                       FontSize="18"
                                       TextColor="{StaticResource AccentText}"
                                       HorizontalTextAlignment="End"/>
                                <Label Text="ปริมาณ"
                                       FontSize="12"
                                       TextColor="{StaticResource MutedText}"
                                       HorizontalTextAlignment="End"/>
                            </StackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Grid Padding="24">
                    <Border Style="{StaticResource CardBorder}">
                        <StackLayout Spacing="6">
                            <Label Text="ยังไม่มีรายการปั๊มนม"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource AccentText}"/>
                            <Label Text="กดปุ่มเพิ่มเพื่อบันทึกครั้งแรกของวันนี้"
                                   FontSize="12"
                                   TextColor="{StaticResource MutedText}"/>
                        </StackLayout>
                    </Border>
                </Grid>
            </CollectionView.EmptyView>
        </CollectionView>
        </RefreshView>
        <Button Grid.Row="2" Text="บันทึกการปั๊มนม"
                Margin="30,20,30,0"
                FontSize="20"
                TextColor="{StaticResource NewButtonTextColor}"
                BackgroundColor="{StaticResource NewButtonBg}"
                Command="{Binding AddNewBreastPumpCommand}"></Button>
    </Grid>
</ContentPage>

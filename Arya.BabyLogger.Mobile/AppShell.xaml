<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Arya.BabyLogger.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:feedview="clr-namespace:Arya.BabyLogger.Mobile.Views.Feed"
    xmlns:breastpumpview="clr-namespace:Arya.BabyLogger.Mobile.Views.BreastPump"
    xmlns:local="clr-namespace:Arya.BabyLogger.Mobile"
    Title="Arya.BabyLogger.Mobile">

    <TabBar>
        <Tab Title="ป้อนนม"
             Icon="milk_bottle.png">
            <ShellContent
                Title="Baby Logger"
                ContentTemplate="{DataTemplate feedview:FeedListPage}"
                Icon="milk_bottle.png"
                Route="FeedListPage"/>
        </Tab>
        <Tab Title="ปั๊มนม"
             Icon="mother_breast_pumping.png">
            <ShellContent
                Title="Breast Pump"
                ContentTemplate="{DataTemplate breastpumpview:BreastPumpListPage}"
                Icon="mother_breast_pumping.png"
                Route="BreastPumpListPage"/>
        </Tab>
    </TabBar>

</Shell>
